# CareWell Hospital AI Receptionist Environment Configuration

# Optional: Google Gemini Free API Key (Get free from https://aistudio.google.com/)
# If left blank, the chatbot seamlessly operates using its built-in intelligent RAG synthesizer
GEMINI_API_KEY=

# Optional: Groq Free API Key (Get free from https://console.groq.com/)
GROQ_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Server Port (Render sets this automatically)
PORT=8000
